#CGI_NO_HEADER
#include "cgi.inc"
#include "db.inc"
SUB MAIN()
    REM Read environment
    pathInfo$ = env$("PATH_INFO")
    IF LEN(pathInfo$) = 0 THEN pathInfo$ = "/"
    REM Route and render
    TRY
        handle_request(pathInfo$)
    CATCH e$
        REM cgi_emit_error(e$)
    END TRY
END SUB

SUB handle_request(pathInfo$)
  p$ = normalize_path$(pathInfo$)

  send_header_ok_html()
  REM PRINTLN p$ // cgi/index.basil

  SELECT CASE p$

    CASE "/"
        render_home_page()

    CASE "/cgi/index.basil"
        render_home_page()

    CASE starts_with%(p$, "/guide")
        REM This doesn't go here.  We have /guide and /reference configured in Apache2 vhost config
        render_guide_placeholder()

    CASE ELSE
        PRINTLN p$
        render_not_found()
        REM render_home_page()
    END SELECT
END SUB

SUB render_home_page()
    html_head("Basil / Basic / Basic.JS Documentation")

    PRINTLN "<main class=\"wrap\" style=\"padding:1rem;\">"
    PRINTLN "  <h1>Basil / Basic / Basic.JS Documentation</h1>"
    PRINTLN "  <p>This is the documentation site for the Basil programming language family.\n"
    PRINTLN "     It is powered by Basil CGI on the backend and plain HTML/CSS/JS on the frontend.</p>"

    PRINTLN "  <div style=\"margin:1.5rem 0; display:flex; gap:1rem; flex-wrap:wrap;\">"
    PRINTLN "    <a class=\"btn\" href=\"/guide\" style=\"display:inline-block;padding:.8rem 1.2rem;border:1px solid #888;border-radius:6px;text-decoration:none\">Guide</a>"
    PRINTLN "    <a class=\"btn\" href=\"/reference\" style=\"display:inline-block;padding:.8rem 1.2rem;border:1px solid #888;border-radius:6px;text-decoration:none\">Reference</a>"
    PRINTLN "    <a class=\"btn\" href=\"/cgi/demos.basil\" style=\"display:inline-block;padding:.8rem 1.2rem;border:1px solid #888;border-radius:6px;text-decoration:none\">Demos</a>"
    PRINTLN "  </div>"

    PRINTLN "  <section style=\"margin-top:1.5rem\">"
    PRINTLN "    <h3>Search</h3>"
    PRINTLN "    <form method=\"GET\" action=\"/search\">"
    PRINTLN "      <input type=\"text\" name=\"q\" placeholder=\"Search docs...\" style=\"padding:.5rem;min-width:240px\">"
    PRINTLN "      <button type=\"submit\">Search</button>"
    PRINTLN "    </form>"
    PRINTLN "  </section>"

    PRINTLN "</main>"

    html_foot()
END SUB

SUB render_guide_placeholder()
    html_head("Guide (Coming Soon)")
    PRINTLN "<main class=\"wrap\" style=\"padding:1rem;\">"
    PRINTLN "  <h1>Guide</h1>"
    PRINTLN "  <p>The Guide will live here. Check back soon.</p>"
    PRINTLN "  <p><a href=\"/\">Return to Home</a></p>"
    PRINTLN "</main>"
    html_foot()
END SUB

SUB render_reference_link()
    html_head("Reference")
    PRINTLN "<main class=\"wrap\" style=\"padding:1rem;\">"
    PRINTLN "  <h1>Reference</h1>"
    PRINTLN "  <p>The Reference lives at <a href=\"/reference\">/reference</a>.</p>"
    PRINTLN "</main>"
    html_foot()
END SUB

SUB render_not_found()
    REM Optionally, emit a 404 status (sending after content-type is ok for many CGI handlers but
    REM if needed, move headers to before printing anything). Keeping minimal as per spec.
    REM PRINTLN "Status: 404 Not Found"
    REM PRINTLN ""

    html_head("Not Found")
    PRINTLN "<main class=\"wrap\" style=\"padding:1rem;\">"
    PRINTLN "  <h1>404 — Not Found</h1>"
    PRINTLN "  <p>The requested page could not be found.</p>"
    PRINTLN "  <p><a href=\"/\">Return to Home</a></p>"
    PRINTLN "</main>"
    html_foot()
END SUB

SUB html_head(title$)
    PRINTLN "<!doctype html>"
    PRINTLN "<html lang=\"en\">"
    PRINTLN "<head>"
    PRINTLN "  <meta charset=\"utf-8\">"
    PRINTLN "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    PRINTLN "  <title>" + html_escape$(title$) + "</title>"
    PRINTLN "  <style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0} .wrap{max-width:980px;margin:0 auto;padding:0 1rem}</style>"
    PRINTLN "</head>"
    PRINTLN "<body>"
    PRINTLN "<header style=\"padding:1rem 0;border-bottom:1px solid #eee;\">"
    PRINTLN "  <div class=\"wrap\" style=\"display:flex; justify-content:space-between; align-items:center;\">"
    PRINTLN "    <strong>Basil Docs</strong>"
    PRINTLN "    <nav><a href=\"/\">Home</a> • <a href=\"/guide\">Guide</a> • <a href=\"/reference\">Reference</a> • <a href=\"/cgi/demos.basil\">Demos</a></nav>"
    PRINTLN "  </div>"
    PRINTLN "</header>"
END SUB

SUB html_foot()
    PRINTLN "<footer style=\"border-top:1px solid #eee;margin-top:2rem\">"
    PRINTLN "  <div class=\"wrap\" style=\"padding:1rem;\"><small>Basil Docs • <a href=\"/\">Home</a> • <a href=\"/guide\">Guide</a> • <a href=\"/reference\">Reference</a> • <a href=\"/cgi/demos.basil\">Demos</a></small></div>"
    PRINTLN "</footer>"
    PRINTLN "</body></html>"
END SUB


REM run
MAIN()