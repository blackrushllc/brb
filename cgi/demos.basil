#CGI_NO_HEADER
#include "cgi.inc"

SUB MAIN()
    send_header_ok_html()
    render_demos_page()
END SUB

SUB render_demos_page()
    html_head("Basil Demos")

    PRINTLN "<main class=\"wrap\" style=\"padding:1rem;\">"
    PRINTLN "  <h1>Basil Demos</h1>"
    PRINTLN "  <p>Explore examples of what you can build with Basil.</p>"

    PRINTLN "  <table style=\"width:100%; border-collapse: collapse; margin-top: 2rem;\">"
    PRINTLN "    <thead>"
    PRINTLN "      <tr style=\"border-bottom: 2px solid #eee; text-align: left;\">"
    PRINTLN "        <th style=\"padding: 1rem;\">Demo</th>"
    PRINTLN "        <th style=\"padding: 1rem;\">About</th>"
    PRINTLN "      </tr>"
    PRINTLN "    </thead>"
    PRINTLN "    <tbody>"

    REM List directories in /demos/
    REM We expect /demos/ to be relative to the root of the project
    REM Since this CGI is in /cgi/, we might need to go up or use absolute path if we knew it.
    REM However, the DIR$ function usually works relative to the current working directory of the process.
    REM In a typical CGI setup, this might be the project root or the cgi directory.
    REM Given the project structure, /demos/ is at the root.

    LET demoDirs$@ = DIR$("/var/www/brb/demos/enabled/*")

    FOR EACH d$ IN demoDirs$@
        REM Ignore files, we only want directories
        REM In Basil, DIR$ returns names. We should check if it's a directory.
        REM For now, we assume subfolders under demos/ are our targets.
        REM Skip "." and ".." if they appear

        IF d$ == "." OR d$ == ".." THEN
            REM PRINTLN " CONTINUE"
        ELSE
            REM Construct paths
            LET aboutPath$ = "/var/www/brb/demos/" + d$ + "/about.html"

            REM Try to read about.html
            aboutContent$ = READFILE$(aboutPath$)

            PRINTLN "      <tr style=\"border-bottom: 1px solid #eee;\">"
            PRINTLN "        <td style=\"padding: 1rem; vertical-align: top;\"><a href=\"/demos/" + d$ + "/\" style=\"font-weight: bold;\">" + d$ + "</a></td>"
            PRINTLN "        <td style=\"padding: 1rem; vertical-align: top;\">" + aboutContent$ + "</td>"
            PRINTLN "      </tr>"
        END IF
    NEXT

    PRINTLN "    </tbody>"
    PRINTLN "  </table>"

    PRINTLN "</main>"

    html_foot()
END SUB

SUB html_head(title$)
    PRINTLN "<!doctype html>"
    PRINTLN "<html lang=\"en\">"
    PRINTLN "<head>"
    PRINTLN "  <meta charset=\"utf-8\">"
    PRINTLN "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    PRINTLN "  <title>" + html_escape$(title$) + "</title>"
    PRINTLN "  <style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0} .wrap{max-width:980px;margin:0 auto;padding:0 1rem}</style>"
    PRINTLN "</head>"
    PRINTLN "<body>"
    PRINTLN "<header style=\"padding:1rem 0;border-bottom:1px solid #eee;\">"
    PRINTLN "  <div class=\"wrap\" style=\"display:flex; justify-content:space-between; align-items:center;\">"
    PRINTLN "    <strong>Basil Docs</strong>"
    PRINTLN "    <nav><a href=\"/\">Home</a> • <a href=\"/guide\">Guide</a> • <a href=\"/reference\">Reference</a> • <a href=\"/cgi/demos.basil\">Demos</a></nav>"
    PRINTLN "  </div>"
    PRINTLN "</header>"
END SUB

SUB html_foot()
    PRINTLN "<footer style=\"border-top:1px solid #eee;margin-top:2rem\">"
    PRINTLN "  <div class=\"wrap\" style=\"padding:1rem;\"><small>Basil Docs • <a href=\"/\">Home</a> • <a href=\"/guide\">Guide</a> • <a href=\"/reference\">Reference</a> • <a href=\"/cgi/demos.basil\">Demos</a></small></div>"
    PRINTLN "</footer>"
    PRINTLN "</body></html>"
END SUB

MAIN()
