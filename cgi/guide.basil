#CGI_NO_HEADER
#include "cgi.inc"

title$ = "Basil Docs"

SUB MAIN()
    REM Read environment
    pathInfo$ = env$("PATH_INFO")
    IF LEN(pathInfo$) = 0 THEN pathInfo$ = "/"
    REM Route and render
    handle_request(pathInfo$)
END SUB

SUB handle_request(pathInfo$)
  p$ = normalize_path$(pathInfo$)

  send_header_ok_html()

  SELECT CASE p$

    CASE "/guide"

        render_guide_placeholder()

    CASE ELSE

        PRINTLN p$
        render_not_found()

    END SELECT
END SUB

SUB render_guide_placeholder()
    html_head()
    OUT$ = "<header style=\"padding:1rem 0;border-bottom:1px solid #eee;\"><div class=\"wrap\"><a href=\"/\">Home</a></div></header>
    <main class=\"wrap\" style=\"padding:1rem;\">
      <h1>Guide</h1>
      <p>The Guide will live here. Check back soon.</p>
      <p><a href=\"/\">Return to Home</a></p>
    </main>"
    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)
    html_foot()
END SUB

SUB render_not_found()
    REM Optionally, emit a 404 status (sending after content-type is ok for many CGI handlers but
    REM if needed, move headers to before printing anything). Keeping minimal as per spec.
    REM PRINTLN "Status: 404 Not Found"
    REM PRINTLN ""

    title$ = "Not Found"

    html_head()

    OUT$ = "<main class=\"wrap\" style=\"padding:1rem;\">
      <h1>404 — Not Found</h1>
      <p>The requested page could not be found.</p>
      <p><a href=\"/\">Return to Home</a></p>
    </main>"

    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)

    html_foot()
END SUB


SUB html_head()

    OUT$ = "<!doctype html>
        <html lang=\"en\">
        <head>
          <meta charset=\"utf-8\">
          <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
          <title>{{ title$ }}</title>
          <style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0} .wrap{max-width:980px;margin:0 auto;padding:0 1rem}</style>
        </head>
        <body>"
    REM PRINTLN OUT$
    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)

END SUB

SUB html_foot()
    OUT$ = "
        <footer style=\"border-top:1px solid #eee;margin-top:2rem\">
        <div class=\"wrap\" style=\"padding:1rem;\"><small>Basil Docs • <a href=\"/\">Home</a> • <a href=\"/guide\">Guide</a> • <a href=\"/reference\">Reference</a></small></div>
        </footer>
        </body></html>"

    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)

END SUB


REM run
MAIN()