#CGI_NO_HEADER
#include "cgi.inc"
#include "db.inc"

title$ = "Basil Docs"

SUB MAIN()
    REM Read environment
    pathInfo$ = env$("PATH_INFO")
    IF LEN(pathInfo$) = 0 THEN pathInfo$ = "/"
    REM Route and render
    TRY
        handle_request(pathInfo$)
    CATCH e$
        cgi_emit_error(e$)
    END TRY
END SUB

SUB handle_request(pathInfo$)
  p$ = normalize_path$(pathInfo$)

  send_header_ok_html()

  IF p$ = "/guide" THEN
      GuideRenderIndex()
      RETURN
  END IF

  LET segments$ = split_path_segments(p$)
  n% = LEN(segments$)
  IF n% >= 3 THEN
      first$ = segments$(1)
      IF first$ = "guide" THEN
          GuideRenderPage(segments$(2))
          RETURN
      END IF
  END IF

  GuideRenderNotFound()
END SUB

SUB render_guide_placeholder()
    html_head()
    OUT$ = "<header style=\"padding:1rem 0;border-bottom:1px solid #eee;\"><div class=\"wrap\"><a href=\"/\">Home</a></div></header>
    <main class=\"wrap\" style=\"padding:1rem;\">
      <h1>Guide</h1>
      <p>The Guide will live here. Check back soon.</p>
      <p><a href=\"/\">Return to Home</a></p>
    </main>"
    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)
    html_foot()
END SUB

SUB render_not_found()
    REM Optionally, emit a 404 status (sending after content-type is ok for many CGI handlers but
    REM if needed, move headers to before printing anything). Keeping minimal as per spec.
    REM PRINTLN "Status: 404 Not Found"
    REM PRINTLN ""

    title$ = "Not Found"

    html_head()

    OUT$ = "<main class=\"wrap\" style=\"padding:1rem;\">
      <h1>404 — Not Found</h1>
      <p>The requested page could not be found.</p>
      <p><a href=\"/\">Return to Home</a></p>
    </main>"

    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)

    html_foot()
END SUB


SUB html_head()

    OUT$ = "<!doctype html>
        <html lang=\"en\">
        <head>
          <meta charset=\"utf-8\">
          <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
          <title>{{ title$ }}</title>
          <style>body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0} .wrap{max-width:980px;margin:0 auto;padding:0 1rem}</style>
        </head>
        <body>"
    REM PRINTLN OUT$
    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)

END SUB

SUB html_foot()
    OUT$ = "
        <footer style=\"border-top:1px solid #eee;margin-top:2rem\">
        <div class=\"wrap\" style=\"padding:1rem;\"><small>Basil Docs • <a href=\"/\">Home</a> • <a href=\"/guide\">Guide</a> • <a href=\"/reference\">Reference</a></small></div>
        </footer>
        </body></html>"

    PRINTLN RENDER$(OUT$) // REM Render the View HTML with the template (see RENDER_AND_FRED.md for more info about templating views)

END SUB


REM run
MAIN()


REM ---------------- Guide (DB + RENDER$) ----------------

FUNCTION GuideBuildNav()
    nav@ = []
    orm@.Table("keywords").Select$("UPPER(LEFT(keyword,1)) AS initial").Get()
    sections@ = orm@.Table("guide_sections").OrderBy$("sort_order%","ASC").Get()
    FOR EACH s@ IN sections@
        sec@ = { "title": s@.Title$, "slug": s@.Slug$, "pages": [] }

        pages@ = orm@.Table("guide_pages").Where$("section_id%","=", s@.Id%).Where$("is_published%","=", 1).OrderBy$("position%","ASC").Get()
        FOR EACH p@ IN pages@
            pageItem@ = { "title": p@.Title$, "slug": p@.Slug$ }
            pi% = LEN(sec@["pages"]) + 1
            sec@["pages"][pi%] = pageItem@
        NEXT

        i% = LEN(nav@) + 1

        // TODO - FIX ADDING TO LIST, instead of out of range error!

        nav@[i%] = sec@
    NEXT

    RETURN nav@
END FUNCTION

FUNCTION GuideGetBeginnerPages()
    list@ = []
    rows@ = orm@.Table("guide_pages").Where$("is_published%","=",1).Where$("difficulty$","=","beginner").OrderBy$("position%","ASC").Get()
    FOR EACH r@ IN rows@
        item@ = { "title": r@.Title$, "slug": r@.Slug$ }
        j% = LEN(list@) + 1
        list@[j%] = item@
    NEXT
    RETURN list@
END FUNCTION

FUNCTION GuideFindPage(slug$)
    out@ = { "title": "", "sectionTitle": "", "difficulty": "", "bodyMd": "" }
    row@ = orm@.Table("guide_pages").Where$("slug$","=", LCASE$(slug$)).Where$("is_published%","=",1).First()

    IF row@ = "NULL" THEN RETURN out@

    sec@ = orm@.Table("guide_sections").Where$("id%","=", row@.Section_id%).First()
    secTitle$ = ""

    IF sec@ <> "NULL" THEN secTitle$ = sec@.Title$

    out@["title"] = row@.Title$
    out@["sectionTitle"] = secTitle$
    out@["difficulty"] = row@.Difficulty$
    out@["bodyMd"] = row@.Body_md$

    RETURN out@
END FUNCTION

SUB GuideRenderIndex()
    nav@ = GuideBuildNav()
    beginner@ = GuideGetBeginnerPages()

    bodyVars@ = { "beginnerPages": beginner@ }
    body$ = RENDER$(READFILE$("views/guide/index.html"), bodyVars@)

    vars@ = { "pageTitle": "Guide", "guideNav": nav@, "pageContentHtml": body$ }
    html$ = RENDER$(READFILE$("views/guide/layout.html"), vars@)
    PRINT html$
END SUB

SUB GuideRenderPage(slug$)
    nav@ = GuideBuildNav()
    page@ = GuideFindPage(slug$)

    IF LEN(page@) = 0 THEN
        GuideRenderNotFound()
        RETURN
    END IF

    bodyVars@ = {
        "pageTitle": page@["title"],
        "sectionTitle": page@["sectionTitle"],
        "difficulty": page@["difficulty"],
        "pageBodyMd": page@["bodyMd"]
    }
    body$ = RENDER$(READFILE$("views/guide/page.html"), bodyVars@)

    vars@ = { "pageTitle": page@["title"], "guideNav": nav@, "pageContentHtml": body$ }
    html$ = RENDER$(READFILE$("views/guide/layout.html"), vars@)
    PRINT html$
END SUB

SUB GuideRenderNotFound()
    nav@ = GuideBuildNav()
    body$ = "<h1>Not Found</h1><p>The requested guide page could not be found.</p>"
    vars@ = { "pageTitle": "Guide — Not Found", "guideNav": nav@, "pageContentHtml": body$ }
    html$ = RENDER$(READFILE$("views/guide/layout.html"), vars@)
    PRINT html$
END SUB

FUNCTION split_path_segments(path$)
    p$ = path$
    IF LEFT$(p$, 1) = "/" THEN p$ = MID$(p$, 2)
    IF LEN(p$) = 0 THEN
        DIM empty$(0)
        RETURN empty$
    END IF

    LET items@ = EXPLODE(path$, "/")

    DIM temp$(LEN(items@)-1)
    FOR i% = 1 TO LEN(items@)
        temp$(i%-1) = items@[i%]
    NEXT
    RETURN temp$
END FUNCTION