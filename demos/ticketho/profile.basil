#include "layout.inc"

<?basil
    db% = db_open%()
    user_id% = get_current_user_id%()
    IF user_id% == 0 THEN
        _ = send_header_redirect("login.basil")
        EXIT 0
    END IF

    msg$ = ""
    err$ = ""
    
    IF ENV$("REQUEST_METHOD") == "POST" THEN
        name$ = param$("name")
        phone$ = param$("phone")
        
        // Handle avatar upload
        avatar_path$ = ""
        IF CGI_HAS_FILE%("avatar") THEN
            fname$ = CGI_FILE_NAME$("avatar")
            IF LEN(fname$) > 0 THEN
                // Simple validation of extension
                ext$ = RIGHT$(LOWER$(fname$), 4)
                IF ext$ == ".jpg" OR ext$ == "jpeg" OR ext$ == ".png" OR ext$ == ".gif" THEN
                    dest$ = "uploads/avatar_" + STR$(user_id%) + "_" + STR$(EPOCH%()) + ext$
                    IF CGI_SAVE_FILE%("avatar", dest$) THEN
                        avatar_path$ = dest$
                    ELSE
                        err$ = "Failed to save avatar."
                    END IF
                ELSE
                    err$ = "Invalid file type. Please upload JPG, PNG, or GIF."
                END IF
            END IF
        END IF
        
        IF LEN(err$) == 0 THEN
            query$ = "UPDATE users SET name = '" + name$ + "', phone = '" + phone$ + "'"
            IF LEN(avatar_path$) > 0 THEN
                query$ = query$ + ", avatar_path = '" + avatar_path$ + "'"
            END IF
            query$ = query$ + ", updated_at = DATETIME('now') WHERE id = " + STR$(user_id%)
            _ = SQLITE_EXEC%(db%, query$)
            msg$ = "Profile updated successfully."
        END IF
    END IF

    // Fetch user info
    DIM urows$(0,0)
    urows$() = SQLITE_QUERY2D$(db%, "SELECT name, email, phone, avatar_path FROM users WHERE id = " + STR$(user_id%))
    user_name$ = urows$(0, 0)
    user_email$ = urows$(0, 1)
    user_phone$ = urows$(0, 2)
    user_avatar$ = urows$(0, 3)
    
    _ = send_header_ok_html()
    _ = layout_start("My Profile")
?>

<section class="profile-page">
    <h2>My Profile</h2>
    
    <?basil IF LEN(msg$) > 0 THEN ?>
        <div class="alert alert-success"><?= msg$ ?></div>
    <?basil END IF ?>
    <?basil IF LEN(err$) > 0 THEN ?>
        <div class="alert alert-error"><?= err$ ?></div>
    <?basil END IF ?>

    <div class="dashboard-grid">
        <div class="card">
            <form method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" value="<?= HTML$(user_name$) ?>" required>
                </div>
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" value="<?= HTML$(user_email$) ?>" disabled>
                    <small>Email cannot be changed.</small>
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="text" id="phone" name="phone" value="<?= HTML$(user_phone$) ?>">
                    <small>Helpful for teams that may later enable notifications.</small>
                </div>
                <div class="form-group">
                    <label for="avatar">Avatar Image</label>
                    <input type="file" id="avatar" name="avatar" accept="image/*">
                    <small>Square images work best. We will keep it tidy.</small>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
        
        <div class="card" style="text-align:center;">
            <h3>Avatar Preview</h3>
            <?basil IF LEN(user_avatar$) > 0 THEN ?>
                <img src="<?= HTML$(user_avatar$) ?>" alt="Avatar" style="width:150px; height:150px; border-radius:50%; object-fit:cover; border:3px solid var(--acc-light);">
            <?basil ELSE ?>
                <div style="width:150px; height:150px; border-radius:50%; background:#e5e7eb; display:flex; align-items:center; justify-content:center; margin:0 auto; font-size:3rem; color:#9ca3af;">
                    <?= LEFT$(user_name$, 1) ?>
                </div>
            <?basil END IF ?>
            <p><?= HTML$(user_name$) ?></p>
        </div>
    </div>
</section>

<?basil
    _ = layout_end()
    SQLITE_CLOSE(db%)
?>
