#include "layout.inc"

<?basil
    db% = db_open%()
    user_id% = get_current_user_id%()
    IF user_id% == 0 THEN
        send_header_redirect("login.basil")
        EXIT 0
    END IF

    ticket_id% = VAL(param$("id"))
    IF ticket_id% == 0 THEN
        send_header_redirect("my_tickets.basil")
        EXIT 0
    END IF


    rows$ = SQLITE_QUERY2D$(db%, "SELECT t.id, t.title, t.description, s.name, t.created_at, t.team_id, t.reporter_user_id, team.name FROM tickets t JOIN statuses s ON t.status_id = s.id JOIN teams team ON t.team_id = team.id WHERE t.id = " + STR$(ticket_id%))

    IF ARRAY_ROWS%(rows$) == 0 THEN
        send_header_ok_html()
        layout_start("Not Found")
        PRINT "<div class=\"alert alert-error\">Ticket not found.</div>"
        layout_end()
        SQLITE_CLOSE(db%)
        EXIT 0
    END IF
    
    team_id% = VAL(rows$(0, 5))
    reporter_id% = VAL(rows$(0, 6))
    
    // Authorization check
    role$ = get_user_role$(db%, team_id%, user_id%)
    IF role$ == "" THEN
        send_header_ok_html()
        layout_start("Access Denied")
        PRINT "<div class=\"alert alert-error\">You do not have access to this ticket.</div>"
        layout_end()
        SQLITE_CLOSE(db%)
        EXIT 0
    ELSEIF role$ == "reporter" AND reporter_id% <> user_id% THEN
        send_header_ok_html()
        layout_start("Access Denied")
        PRINT "<div class=\"alert alert-error\">Reporters can only view their own tickets.</div>"
        layout_end()
        SQLITE_CLOSE(db%)
        EXIT 0
    END IF
    
    send_header_ok_html()
    layout_start("Ticket Detail")
?>

<section class="ticket-detail">
    <div class="breadcrumb">
        <a href="dashboard.basil">Dashboard</a> / <a href="my_tickets.basil">My Tickets</a> / #<?= rows$(0, 0) ?>
    </div>
    
    <div class="card">
        <header class="card-header">
            <h2><?= HTML$(rows$(0, 1)) ?></h2>
            <span class="badge status-<?= HTML$(LOWER$(rows$(0, 3))) ?>"><?= HTML$(rows$(0, 3)) ?></span>
        </header>
        
        <div class="ticket-meta">
            <p><strong>Team:</strong> <?= HTML$(rows$(0, 7)) ?></p>
            <p><strong>Created:</strong> <?= HTML$(rows$(0, 4)) ?></p>
        </div>
        
        <div class="ticket-body">
            <h3>Description</h3>
            <div class="description"><?= HTML$(rows$(0, 2)) ?></div>
        </div>
    </div>
    
    <div class="actions">
        <?basil IF role$ == "owner" OR role$ == "admin" OR role$ == "member" THEN ?>
            <a href="edit_ticket.basil?id=<?= rows$(0, 0) ?>" class="btn btn-primary">Edit Ticket</a>
        <?basil END IF ?>
        <a href="my_tickets.basil" class="btn btn-ghost">Back to List</a>
    </div>
</section>

<?basil
    layout_end()
    SQLITE_CLOSE(db%)
?>
