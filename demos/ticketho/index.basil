    $quote_cards = [
        [ "quote": "It feels like a real ticket system, but somehow less grumpy.", "by": "A pleasantly surprised team admin" ],
        [ "quote": "Our reporters actually made it to the form without needing a map.", "by": "Someone who has met normal intake pages before" ],
        [ "quote": "Clean enough for real work, light enough for a demo kingdom.", "by": "An admirer of tidy little systems" ]
    ]
?>

<section class="hero">
    <h1><?= $page_copy["hero_title"] ?></h1>
    <p class="subtitle"><?= $page_copy["hero_subtitle"] ?></p>
    <p><?= $page_copy["hero_body"] ?></p>
    <div class="hero-actions">
        <a href="register.basil" class="btn btn-primary">Get Started Free</a>
        <a href="intake.basil" class="btn btn-secondary">Submit a Ticket</a>
    </div>
</section>

<section id="features" class="feature-grid">
    <h2><?= $page_copy["features_heading"] ?></h2>
    <p><?= $page_copy["features_body"] ?></p>
    <div class="cards">
        <?basil foreach ($feature_cards as $card) { ?>
            <article class="card">
                <h3><?= $card["title"] ?></h3>
                <p><?= $card["desc"] ?></p>
            </article>
        <?basil } ?>
    </div>
</section>

<section id="how-it-works" class="how-it-works">
    <h2><?= $page_copy["how_heading"] ?></h2>
    <p><?= $page_copy["how_body"] ?></p>
    <div class="steps">
        <?basil foreach ($how_it_works_steps as $step) { ?>
            <div class="step">
                <div class="step-num"><?= $step["step"] ?></div>
                <h3><?= $step["title"] ?></h3>
                <p><?= $step["desc"] ?></p>
            </div>
        <?basil } ?>
    </div>
</section>

<section class="syndorela-initiative">
    <h2><?= $page_copy["free_heading"] ?></h2>
    <p><?= $page_copy["free_body"] ?></p>
    <p><a href="https://syndorela.com" class="btn btn-ghost">Visit Syndorela Kingdom</a></p>
</section>

<section class="quotes">
    <div class="cards">
        <?basil foreach ($quote_cards as $quote) { ?>
            <div class="card quote-card">
                <p class="quote">"<?= HTML$(quote["quote"]) ?>"</p>
                <p class="by">- <?= HTML$(quote["by"]) ?></p>
            </div>
        <?basil } ?>
    </div>
</section>

<section id="coming-soon" class="coming-soon">
    <h2><?= $page_copy["soon_heading"] ?></h2>
    <p><?= $page_copy["soon_body"] ?></p>
    <ul>
        <?basil foreach ($coming_soon_items as $item) { ?>
            <li><?= $item ?></li>
        <?basil } ?>
    </ul>
</section>

<section class="final-cta">
    <h2><?= $page_copy["final_heading"] ?></h2>
    <p><?= $page_copy["final_body"] ?></p>
    <a href="register.basil" class="btn btn-primary">Create Your Account</a>
</section>

<?basil
    _ = layout_end()
    SQLITE_CLOSE(db%)
?>
