#include "layout.inc"

<?basil
    db% = db_open%()
    _ = send_header_ok_html()
    _ = layout_start("Home")

    $page_copy = [
        "hero_title": "TICKETHO",
        "hero_subtitle": "Friendly team ticketing with a cleaner front door.",
        "hero_body": "TICKETHO helps teams collect tickets, guide new reporters into the right place, and keep work organized without making the process feel heavy. It is free to use and offered as part of the Syndorela Kingdom educational initiative.",
        "intro_heading": "A simpler path from request to resolution",
        "intro_body": "TICKETHO gives teams a tidy way to accept incoming tickets, onboard reporters through email-confirmed access, and keep everything connected to the right team from the very beginning.",
        "features_heading": "Everything a small team needs to get moving",
        "features_body": "From public intake links to role-aware ticket visibility, TICKETHO is built to make ticket submission easier for reporters and easier to manage for staff.",
        "how_heading": "From “I need help” to “ticket submitted”",
        "how_body": "The path is straightforward: confirm who you are, land in the right place, and create the ticket without ceremony.",
        "reporter_heading": "A better path than an anonymous form",
        "reporter_body": "Instead of dropping people into a faceless support box, TICKETHO confirms their email, gives them an account, and lets them return later to view their own tickets with confidence.",
        "admin_heading": "Built to help teams stay organized",
        "admin_body": "Team admins can create public intake links, manage members, promote reporters when needed, shape ticket workflows, and prepare for richer notification features as the platform grows.",
        "free_heading": "A free tool from the Syndorela Kingdom",
        "free_body": "TICKETHO is part of a broader educational effort to build useful, approachable software that teaches by example. We like making clever tools, sharing what they can do, and leaving the workshop door open for others to learn from the result.",
        "soon_heading": "More gears for the kingdom workshop",
        "soon_body": "TICKETHO already covers the essential path into team ticketing, and there is plenty more waiting on the workbench.",
        "final_heading": "Ready to open a better ticket door?",
        "final_body": "Start with a friendlier workflow, invite your team, and let TICKETHO do the guiding."
    ]

    $feature_cards = [
        [ "title": "Team-Based Tickets", "desc": "Keep incoming work organized by team so requests land where they belong instead of drifting through inbox fog." ],
        [ "title": "Public Intake Links", "desc": "Let each team generate its own intake entry point for cleaner routing and fewer misplaced requests." ],
        [ "title": "Guided Reporter Onboarding", "desc": "New reporters confirm their email, log in automatically, and land right inside the correct ticket flow." ],
        [ "title": "Reporter-Friendly Access", "desc": "Reporters can return later and view their own tickets without wandering through staff-only screens." ],
        [ "title": "Custom Status Workflows", "desc": "Start with sensible defaults and expand into team-specific statuses as your process takes shape." ],
        [ "title": "Simple Admin Controls", "desc": "Manage members, roles, intake links, and ticket flow from one clean team workspace." ],
        [ "title": "Mobile-Friendly Pages", "desc": "Built to stay readable and usable on smaller screens when people are away from their desks." ],
        [ "title": "Built for Extension", "desc": "Ready for future comments, attachments, reply-based updates, watchers, and richer integrations." ],
        [ "title": "Educational Basil Demo", "desc": "A practical example of how Basil templating and app logic can come together in a real little product." ]
    ]

    $how_it_works_steps = [
        [ "step": "1", "title": "Create a team intake link", "desc": "A team admin generates a public link for their team so new requests can arrive through the right front door." ],
        [ "step": "2", "title": "Reporter enters basic details", "desc": "The visitor provides their name, phone number, and email address to begin the process." ],
        [ "step": "3", "title": "Confirmation link arrives", "desc": "TICKETHO sends a secure email link that confirms the account and doubles as an instant login." ],
        [ "step": "4", "title": "Auto-login to the ticket form", "desc": "Clicking the link drops the reporter directly into the correct ticket form for that team." ],
        [ "step": "5", "title": "Ticket lands in the right place", "desc": "The new ticket is created inside the intended team, or in the default team when using the generic intake path." ],
        [ "step": "6", "title": "Come back anytime", "desc": "The reporter can log in later and check only their own tickets without any extra maze-solving." ]
    ]

    $coming_soon_items = [
        "Custom intake forms for each team",
        "Ticket comments and discussion threads",
        "File attachments",
        "Assign tickets to staff members",
        "Watchers and follower notifications",
